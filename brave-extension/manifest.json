{
  "manifest_version": 3,
  "name": "Antigravity Mission Control (Browser HUD)",
  "version": "2.0.0",
  "description": "Real-time browser activity monitor, CDP telemetry stream, and Antigravity directive bridge for Brave.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Antigravity Mission Control"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8765/*"
  ],
  "commands": {
    "toggle-hud": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle Antigravity Mission Control HUD on current page"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/hud.js"],
      "css": ["content/hud.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
